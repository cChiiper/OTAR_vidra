// Local Step 3 profile. Step 1 / Step 2 are launched separately.

workDir = "${projectDir}/.nextflow_work_local"
cleanup = false

def hostUid = System.getenv('HOST_UID')
def hostGid = System.getenv('HOST_GID')
def userFlag = (hostUid && hostGid) ? "--user ${hostUid}:${hostGid}" : ""

docker {
    enabled = true
    runOptions = "--platform=linux/amd64 ${userFlag} -v ${projectDir}:${projectDir}"
}

process {
    executor      = 'local'
    queueSize     = 4
    stageInMode   = 'copy'
    maxRetries    = 0
    errorStrategy = 'terminate'
    container     = params.bayes_image

    withName: RUN_BAYESIAN_ANALYSIS_PER_GENE {
        maxForks  = params.bayes_gene_max_forks
    }
}

params {
    execution_mode       = 'local'
    trace_report_suffix  = "local_${new Date().format('yyyyMMdd_HHmmss_SSS')}"
    bayes_gene_max_forks = 2
}

includeConfig 'reporting.config'
