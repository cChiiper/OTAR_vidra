includeConfig 'gcloud_base.config'

workDir = 'gs://vidra-2-0/nextflow/work/gcloud_prod'
cleanup = false

params {
    genes                     = 'gs://vidra-2-0/nextflow/reference/all_protein_coding_ENSG.csv'
    execution_mode            = 'gcloud'
    gcp_project               = 'open-targets-eu-dev'
    gcp_region                = 'europe-west1'
    gcp_service_account_email = ''
    outdir                    = 'gs://vidra-2-0/nextflow/results/gcloud_prod'
    bucket_uri                = "${params.outdir}"
    trace_report_suffix       = "gcloud_prod_${new Date().format('yyyyMMdd_HHmmss_SSS')}"
    bayes_gene_max_forks      = 128
}

includeConfig 'gcloud_google.config'
includeConfig 'reporting.config'

process {
    withName: RUN_BAYESIAN_ANALYSIS_PER_GENE {
        maxForks      = params.bayes_gene_max_forks
        // For the full production gene set, retry once and then keep the
        // remaining independent genes moving. Failed genes are visible in the
        // execution trace/report and can be rerun with -resume.
        errorStrategy = { task.attempt <= 1 ? 'retry' : 'ignore' } // With spot machines the very long runs may fail and need rerun
        maxRetries    = 1
        maxErrors     = -1
        cpus          = 2
        memory        = '4 GB'
        machineType   = 'e2-standard-2'
        disk          = '15.GB'
        time          = { task.attempt > 1 ? '120m' : '15m' } // For PCSK9 you may want 150m to be sure if a lot of ClinVar data is kept (single submitter)
    }
}
