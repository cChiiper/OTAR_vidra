process {
    shell = ['/bin/bash', '-euo', 'pipefail']

    withLabel: process_single {
        cpus   = 1
        memory = '4 GB'
        time   = '60m'
    }
}

docker.enabled = false

params {
    // Optional text file of ENSG IDs used only to restrict Step 3 to a subset
    // of the gene partitions already present under analysis_ready_dir.
    genes                    = null

    // Base output location for traces and for the canonical Step 3 outputs.
    outdir                   = "${projectDir}/results"
    bucket_uri               = "${params.outdir}"
    trace_report_suffix      = 'local'

    // Step 3 tool entrypoints inside the Bayes runtime image.
    bayes_script             = '/app/tools/run_bayesian_analysis.py'

    // Runtime images:
    // - prepare_image is kept for the external Step 1 launcher
    // - annotation_image is kept for the external Step 2 launcher
    // - bayes_image is the only image used by Nextflow itself
    prepare_image            = 'vidra5-spark-dataproc:latest'
    prepare_image_registry   = 'europe-west1-docker.pkg.dev/open-targets-genetics-dev/opentargets/vidra5-spark-dataproc:latest'
    annotation_image         = 'vidra5-annotation:latest'
    annotation_image_registry = 'europe-west1-docker.pkg.dev/open-targets-genetics-dev/opentargets/vidra5-annotation:latest'
    bayes_image              = 'vidra5-bayes:latest'
    bayes_image_registry     = 'europe-west1-docker.pkg.dev/open-targets-genetics-dev/opentargets/vidra5-bayes:latest'

    // Step 3 analysis settings.
    h1                       = 0.1
    bayes_gene_max_forks     = 2

    // Canonical logical output directories under bucket_uri.
    analysis_ready_dir       = 'vidra_analysis_ready'
    annotations_dir          = 'variant_annotations'
    annotations_output_name  = 'annotations.parquet'
    bayes_results_dir        = 'vidra_results'

    // Execution mode is still useful for minor local vs gs:// path handling.
    execution_mode           = 'local'

    // Cloud settings used only by the Step 3 gcloud profiles and by the
    // external Step 1 / Step 2 launchers from the Makefile.
    gcp_project              = ''
    gcp_region               = 'europe-west1'
    gcp_service_account_email = ''
}
