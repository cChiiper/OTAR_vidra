// Shared defaults live in conf/base.config.
includeConfig 'conf/base.config'

plugins {
    id 'nf-google'
}

manifest {
    name            = 'VIDRA_5'
    description     = 'Hybrid VIDRA pipeline: external Step 1/2 with per-gene Nextflow Bayesian analysis'
    mainScript      = 'main.nf'
    nextflowVersion = '!>=25.04.0'
}

profiles {
    local {
        includeConfig 'conf/local.config'
    }

    test {
        includeConfig 'conf/test.config'
    }

    gcloud_test {
        includeConfig 'conf/gcloud_test.config'
    }

    gcloud_prod {
        includeConfig 'conf/gcloud_prod.config'
    }
}
